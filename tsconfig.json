{
  "compilerOptions": {
    "types": ["jest","node"], 
   "target": "ES6",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noEmit": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true                             /* Skip type checking all .d.ts files. */
  }
}
